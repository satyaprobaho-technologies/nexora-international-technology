# Public canonical website URL
NEXT_PUBLIC_SITE_URL=https://nexora-international-technology.vercel.app

# Firebase Admin service account JSON (server-only; never use NEXT_PUBLIC_ prefix)
FIREBASE_SERVICE_ACCOUNT_JSON=

# SSLCOMMERZ credentials from your approved merchant account
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Never commit real credentials. Configure these in Vercel Project Settings > Environment Variables.

# Keep false until an approved merchant account and verified live credentials are available.
PAYMENTS_ENABLED=false

# Optional one-time bootstrap for manual wallet payment settings (server-only)
NEXORA_BKASH_NUMBER=
NEXORA_NAGAD_NUMBER=
